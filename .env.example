# Database (PostgreSQL)
DATABASE_URL="postgresql://sitelens:sitelens_secret@postgres:5432/sitelens"
POSTGRES_USER="sitelens"
POSTGRES_PASSWORD="sitelens_secret"
POSTGRES_DB="sitelens"

# Security & Session
SESSION_SECRET="replace-with-a-long-random-hex-secret"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="SiteLens#Pilot2026"

# Local Disk Media Storage
UPLOAD_DIR="/data/uploads"

# Domain & WebAuthn (Required for HTTPS + Fingerprint/Passkeys in production)
SITE_DOMAIN="localhost"
RP_ID="localhost"
RP_ORIGIN="https://localhost"

# Optional: Gemini AI (BYOK - app & Tesseract OCR still work if left empty)
GEMINI_API_KEY=""

# Optional: Notifications (SMTP Email & Webhook)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SiteLens Alerts <noreply@sitelens.local>"
WEBHOOK_URL=""
